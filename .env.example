# Copy to .env and fill in.

# Path to YAML config (default: ./config.yaml)
ENVIROPI_CONFIG=./config.yaml

# SQLite database path
ENVIROPI_DB=./data/enviropi.db

# Use mock sensors when not on a Pi with Enviro+
ENVIROPI_MOCK_SENSORS=true

# Deploy identity (personal — keep in .env, not committed config)
# systemd User=/Group= on the Pi (push-to-pi.sh rewrites unit files)
ENVIROPI_SERVICE_USER=pi
# Tailscale MagicDNS hostname (no scheme/port). Drives dashboard_url + OAuth base.
ENVIROPI_TAILSCALE_HOST=enviropi.example.ts.net
# Optional SSH target for make push / push-to-pi.sh (defaults to USER@HOST above)
# ENVIROPI_HOST=pi@enviropi.example.ts.net
# Optional full dashboard URL override (else http://$ENVIROPI_TAILSCALE_HOST:$WEB_PORT)
# ENVIROPI_DASHBOARD_URL=http://enviropi.example.ts.net:8000

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID that receives alerts (your user or group)
TELEGRAM_ALERT_CHAT_ID=
# Comma-separated numeric user ids allowed to run bot commands.
# Optional: a positive TELEGRAM_ALERT_CHAT_ID is auto-allowed for private chats.
TELEGRAM_ALLOWLIST=

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Console + how users reach the dashboard (Tailscale MagicDNS on Pi)
# push-to-pi.sh rewrites this from ENVIROPI_TAILSCALE_HOST when deploying.
OAUTH_REDIRECT_URI=http://enviropi.example.ts.net:8000/auth/callback
# Comma-separated emails allowed to use the dashboard
OAUTH_ALLOWLIST=you@gmail.com

# Session signing secret (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Dashboard HTTP server (enviropi-web). Set false to skip binding while
# enviropi-collector keeps polling sensors / alerts / Telegram.
DASHBOARD_ENABLED=true

# Enviro+ LCD: wake on proximity (look/near), sleep after idle. Not permanently on.
# Ignored when ENVIROPI_MOCK_SENSORS=true. Set false to leave the backlight alone.
DISPLAY_ENABLED=true

# Web bind (ignored when DASHBOARD_ENABLED=false).
# On Pi: bind all interfaces and rely on UFW (allow only on tailscale0).
# Local mock: use 127.0.0.1 instead.
WEB_HOST=0.0.0.0
WEB_PORT=8000
