# Cross-build EnviroPi deps for Raspberry Pi Zero (armv6l / armhf).
# Run via scripts/build-armv6.sh (docker buildx --platform linux/arm/v6).
#
# Base: Raspberry Pi OS Trixie armhf (real armv6 userland + Python 3.13).
# balenalib/raspberry-pi-debian has no trixie; official python:3.13-slim has no arm/v6.
# QEMU_CPU=arm1176 keeps uname/pip targeting armv6l under buildx/qemu.
ARG BASE_IMAGE=vascoguita/raspios:armhf-trixie
ARG QEMU_CPU=arm1176
FROM ${BASE_IMAGE} AS build

ARG QEMU_CPU=arm1176
ENV QEMU_CPU=${QEMU_CPU} \
    DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_EXTRA_INDEX_URL=https://www.piwheels.org/simple

# Full raspios rootfs is tight; keep apt archives on tmpfs and trim docs.
RUN --mount=type=tmpfs,target=/var/cache/apt \
    --mount=type=tmpfs,target=/tmp \
    rm -rf /usr/share/doc /usr/share/man /usr/share/locale \
 && mkdir -p /var/cache/apt/archives/partial \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-venv \
      python3-dev \
      python3-pip \
      libopenblas0 \
      libjpeg62-turbo \
      zlib1g \
      libfreetype6 \
      libportaudio2 \
      build-essential \
      pkg-config \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY pyproject.toml requirements.txt README.md ./
COPY src ./src
COPY systemd ./systemd

RUN python3 -V \
 && python3 -m venv /opt/enviropi-venv \
 && /opt/enviropi-venv/bin/pip install -U pip wheel \
 && /opt/enviropi-venv/bin/pip install -e . \
 && /opt/enviropi-venv/bin/pip install \
      enviroplus st7735 fonts pillow smbus2 RPi.GPIO \
 && /opt/enviropi-venv/bin/python -c "import enviropi, st7735, numpy, sys; print('venv_ok', sys.version)" \
 && printf '%s\n' "armv6l" > /opt/enviropi-venv/.enviropi-arch \
 && /opt/enviropi-venv/bin/python -c "import sys; open('/opt/enviropi-venv/.enviropi-python','w').write(sys.version)" \
 && /opt/enviropi-venv/bin/python -c "import sys; open('/opt/enviropi-venv/.enviropi-python-mm','w').write(f'{sys.version_info.major}.{sys.version_info.minor}\n')"

# Export: only the venv tree (copied out by build-armv6.sh)
ARG BASE_IMAGE=vascoguita/raspios:armhf-trixie
FROM ${BASE_IMAGE} AS export
COPY --from=build /opt/enviropi-venv /venv
