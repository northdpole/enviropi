[Unit]
Description=EnviroPi sensor collector and Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/embedded-stack/apps/enviropi
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/embedded-stack/apps/enviropi/.env
ExecStart=/opt/embedded-stack/apps/enviropi/.venv/bin/enviropi-collector
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
